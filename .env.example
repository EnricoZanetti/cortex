# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Secrets (required) ----------------------------------------------------
# Used to embed document chunks and search queries, and to serve the GPT chat models.
OPENAI_API_KEY=sk-...
# Bearer token MCP clients must present. Generate one: openssl rand -hex 32
MCP_API_KEY=change-me-to-a-long-random-string
# Signs chat-login JWTs. Generate one: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Auth --------------------------------------------------------------------
# Session lifetime for a signed-in chat user.
JWT_EXPIRES_MINUTES=10080
# Free /chat turns a new signup gets on your own provider keys, before the UI
# asks them for a personal key.
FREE_RUNS_PER_USER=3
# Optional: bootstrap one admin login (unlimited free runs on your own keys), so
# you can hand it out to let people try the tool without signing up. Leave both
# blank to skip. Changing either and restarting rotates the admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Chat assistant LLM providers ------------------------------------------
# Each key enables that provider's models in the chat model picker. Set as many
# or as few as you like: models with no key are shown greyed out with the
# variable that would enable them, and the rest keep working.
#
#   ANTHROPIC_API_KEY -> Claude Opus 5, Claude Sonnet 5, Claude Haiku 4.5
#   OPENAI_API_KEY    -> GPT-5.1, GPT-5 mini   (also used for embeddings)
#   GOOGLE_API_KEY    -> Gemini 2.5 Pro, Gemini 2.5 Flash
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=

# Where the chat assistant reaches the MCP server. It connects as an ordinary MCP
# client over Streamable HTTP with MCP_API_KEY, exactly as an external agent would.
# Inside docker-compose this is the service name; leave it unless you deploy
# the MCP server separately.
MCP_SERVER_URL=http://mcp:8080/mcp
# Safety valve on the agent loop: tool-call rounds allowed per question.
CHAT_MAX_TOOL_ITERATIONS=8
CHAT_MAX_OUTPUT_TOKENS=4096

# --- Embeddings ------------------------------------------------------------
# 'openai' = real semantic embeddings (needs OPENAI_API_KEY).
# 'hash'   = offline stand-in, no API key needed. Retrieval falls back to
#            keyword-only search. Use it to try the stack without credentials.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Chunking --------------------------------------------------------------
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
CHUNK_MIN_TOKENS=150

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_CANDIDATE_POOL=40
RRF_K=60
MAX_CHUNKS_PER_DOCUMENT=3

# --- Storage (defaults match docker-compose; override for external services) -
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=kb
# Set DATABASE_URL / QDRANT_URL directly when not using docker-compose.
# DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/kb
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks

# --- Networking ------------------------------------------------------------
API_PORT=8000
MCP_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
QDRANT_PORT=6333

# Origin(s) the browser app is served from; comma-separated.
CORS_ORIGINS=http://localhost:3000
# Public URL of the API, baked into the frontend bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host/Origin allow-lists for the MCP transport's DNS-rebinding protection.
# '*' disables the check (correct behind a load balancer or tunnel).
# Set an explicit comma-separated list for a fixed-domain deployment.
MCP_ALLOWED_HOSTS=*
MCP_ALLOWED_ORIGINS=*

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
